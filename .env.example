# 复制为 .env 后填写（不要提交 .env）
JARVIS_HOST=127.0.0.1
JARVIS_PORT=1690

# DeepSeek（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# 初始管理员（首次写入 MySQL users 表；之后改库内密码即可）
AUTH_ACCOUNT=jarvis
AUTH_PASSWORD=change-me-please
AUTH_TOKEN_TTL_HOURS=24

# 知识原文与上传
KNOWLEDGE_DIR=./knowledge
KB_UPLOAD_MAX_MB=8

# 业务库（必需）。启动：bash scripts/mysql.sh up
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=jarvis
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_DATABASE=jarvis

# 知识向量库（必需，Milvus）。启动：bash scripts/milvus.sh up
MILVUS_URI=http://127.0.0.1:19530
MILVUS_PORT=19530
MILVUS_COLLECTION=jarvis_kb
ATTU_PORT=18000

# 向量化：hash=本地算法不上网；openai=兼容 /v1/embeddings（硅基 BGE-M3 等）
# DeepSeek 没有 embedding 接口
EMBEDDING_BACKEND=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=
RERANK_API_KEY=

QUOTE_INTERVAL_SEC=15
KLINE_INTERVAL_SEC=300
JARVIS_GRAPH_MAX_TOOL_ROUNDS=4
