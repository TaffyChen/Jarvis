# 复制为 .env 后填写（不要提交 .env）
JARVIS_HOST=127.0.0.1
JARVIS_PORT=1690

# DeepSeek（OpenAI 兼容）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat

# 初始管理员（首次写入 MySQL users 表；之后改库内密码即可）
AUTH_ACCOUNT=jarvis
AUTH_PASSWORD=change-me-please
AUTH_TOKEN_TTL_HOURS=24

# 数据与知识库
DATA_DIR=./data
KNOWLEDGE_DIR=./knowledge
# 知识库上传体积上限（MB）：md/txt/pdf/docx/xlsx/html/csv
KB_UPLOAD_MAX_MB=8
VECTOR_DIR=./data/vectordb
# local=本地 JSON 向量；milvus=Docker Milvus（bash scripts/milvus.sh up）
VECTOR_BACKEND=local
MILVUS_URI=http://127.0.0.1:19530
MILVUS_PORT=19530
MILVUS_COLLECTION=jarvis_kb
ATTU_PORT=18000

# 向量化：hash=本地 n-gram（默认，DeepSeek 无 embedding 接口）
# openai=兼容 /v1/embeddings（OpenAI / 本地 bge / 硅基流动等）
EMBEDDING_BACKEND=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# 对话重排（可与 embedding 共用硅基 Key；关掉则只用向量+关键词）
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=
RERANK_API_KEY=

# 可选：Jarvis 专用 MySQL（Docker）。留空 MYSQL_HOST 则继续只用 data/*.json
# 启动容器：bash scripts/mysql.sh up
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=jarvis
MYSQL_PASSWORD=change-me-mysql
MYSQL_ROOT_PASSWORD=change-me-mysql-root
MYSQL_DATABASE=jarvis
MYSQL_MIRROR_JSON=false

# 行情刷新（秒）
QUOTE_INTERVAL_SEC=15
KLINE_INTERVAL_SEC=300

# LangGraph 决策图：工具轮次上限（达到后强制收束回答）
JARVIS_GRAPH_MAX_TOOL_ROUNDS=4
